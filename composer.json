{
    "name": "phalanx-php/agent-harness",
    "description": "Phalanx Agent Harness starter kit",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "agent",
        "agent-harness",
        "bootstrap",
        "phalanx"
    ],
    "authors": [
        {
            "name": "Jonathan Havens",
            "email": "mail@phalanx-php.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "phalanx-php/phalanx": "^2.0@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "analyse": "php vendor/bin/phpstan analyse --memory-limit=512M",
        "release:check": "php tools/release-composer-check.php",
        "release:composer": "php tools/release-composer.php --stdout",
        "test": "php -d memory_limit=512M vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "autoload": {
        "psr-4": {
            "App\\AgentHarness\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\AgentHarness\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../phalanx",
            "options": {
                "symlink": true,
                "versions": {
                    "phalanx-php/phalanx": "2.0.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
