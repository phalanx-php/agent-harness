{
    "name": "phalanx-php/agent-harness-starter",
    "description": "Phalanx AgentHarness starter kit",
    "type": "project",
    "license": "MIT",
    "bin": ["bin/harness"],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-openswoole": "^26.2",
        "ext-pcntl": "*",
        "phalanx-php/harness": "^0.6",
        "symfony/runtime": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "test": "php -d memory_limit=512M vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "autoload": {
        "psr-4": {
            "App\\AgentHarness\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\AgentHarness\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
