{
    "name": "phalanx-php/collab-starter",
    "description": "Phalanx Collab starter kit",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "agent",
        "collab",
        "phalanx",
        "swoole",
        "tui"
    ],
    "authors": [
        {
            "name": "Jonathan Havens",
            "email": "mail@phalanx-php.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-swoole": "^6.0",
        "phalanx-php/phalanx": "0.7.x-dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "analyse": "php vendor/bin/phpstan analyse --memory-limit=512M",
        "test": "php -d memory_limit=512M vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "autoload": {
        "psr-4": {
            "App\\Collab\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Collab\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.7.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../phalanx",
            "options": {
                "symlink": true,
                "versions": {
                    "phalanx-php/phalanx": "0.7.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
