{
    "name": "phalanx-php/agent-harness-starter",
    "description": "Phalanx AgentHarness starter kit",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "agent",
        "agent-harness",
        "phalanx",
        "swoole",
        "tui"
    ],
    "homepage": "https://github.com/phalanx-php/agent-harness-starter",
    "authors": [
        {
            "name": "Jonathan Havens",
            "email": "mail@phalanx-php.com"
        }
    ],
    "support": {
        "source": "https://github.com/phalanx-php/agent-harness-starter"
    },
    "bin": ["bin/agent-harness"],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-swoole": "^6.0",
        "phalanx-php/phalanx": "@dev",
        "symfony/runtime": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "analyse": "php vendor/bin/phpstan analyse --memory-limit=512M",
        "test": "php -d memory_limit=512M vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "archive": {
        "exclude": [
            "/.aimind",
            "/.aimind/**",
            "/.claude",
            "/.claude/**",
            "/.daemon8",
            "/.daemon8/**",
            "/.DS_Store",
            "/.env*",
            "/**/.env*",
            "/.github",
            "/.github/**",
            "/.idea",
            "/.idea/**",
            "/.phpstan-cache",
            "/.phpstan-cache/**",
            "/.phpunit.result.cache",
            "/tests",
            "/tests/**",
            "/vendor",
            "/vendor/**"
        ]
    },
    "autoload": {
        "psr-4": {
            "App\\AgentHarness\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\AgentHarness\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../phalanx"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
