{
    "name": "phalanx-php/agent-collab-starter",
    "description": "Phalanx AgentCollab starter kit",
    "type": "project",
    "license": "MIT",
    "bin": ["bin/collab"],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-swoole": "^6.0",
        "phalanx-php/panoply": "^0.6",
        "phalanx-php/theatron": "^0.6",
        "phalanx-php/themis": "^0.6",
        "symfony/runtime": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "test": "php -d memory_limit=512M vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "autoload": {
        "psr-4": {
            "App\\AgentCollab\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\AgentCollab\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
