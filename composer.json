{
    "name": "phalanx-php/agent-harness-starter",
    "description": "Phalanx AgentHarness starter kit",
    "type": "project",
    "license": "MIT",
    "bin": ["bin/agent-harness"],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-theatron.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-aegis.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-athena.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-grammata.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-themis.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-iris.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-styx.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-surreal.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-hermes.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-stoa.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/phalanx-php/phalanx-panoply.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-swoole": "^6.0",
        "phalanx-php/theatron": "^0.6",
        "symfony/runtime": "^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "scripts": {
        "test": "php -d memory_limit=512M vendor/bin/phpunit -c phpunit.xml.dist"
    },
    "autoload": {
        "psr-4": {
            "App\\AgentHarness\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\AgentHarness\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
